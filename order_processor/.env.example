# ── Database ──────────────────────────────────
DB_USER=test_user
DB_PASS=test_pass
DB_NAME=orders
DB_HOST=postgres
DB_PORT=5432

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_STREAM_KEY=orders
REDIS_DLQ_STREAM_KEY=orders_dlq
REDIS_GROUP_NAME=order_processors

# ── Worker ────────────────────────────────────
CONSUMER_NAME=worker_1
MAX_PARALLEL_ORDERS=5
POLL_TIMEOUT_MS=5000
WORKER_REPLICAS=3

# ── Retry & DLQ ───────────────────────────────
MAX_RETRIES=3
RETRY_DELAY_SECONDS=3

# ── Test Producer ─────────────────────────────
TEST_NUM_ORDERS=20
